{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ISE Color Theme",
  "type": "object",
  "required": [
    "Name",
    "FontFamily",
    "FontSize",
    "Colors"
  ],
  "properties": {
    "Name": {
      "type": "string",
      "description": "The friendly display name of the color theme.",
      "examples": [
        "Monokai",
        "One Half Dark",
        "One Half Light",
        "Catppuccin Mocha",
        "Catppuccin Latte"
      ]
    },
    "FontFamily": {
      "type": "string",
      "default": "Cascadia Code",
      "description": "The font family used in both the editor and console panes.",
      "examples": [
        "Fira Code",
        "Fira Mono",
        "JetBrains Mono",
        "Cascadia Code",
        "Consolas"
      ]
    },
    "FontSize": {
      "type": "integer",
      "default": 12,
      "minimum": 4,
      "maximum": 72,
      "description": "The font size in points."
    },
    "Colors": {
      "type": "object",
      "description": "Color values for each ISE pane and token highlighting element. Individual color values can be either a standard 8-character hex color code (e.g. #FF012456) or an ARGB signed integer.",
      "additionalProperties": false,
      "required": [
        "Output",
        "Console",
        "Editor"
      ],
      "properties": {
        "Output": {
          "title": "Stream Output Colors",
          "description": "Colors for the different output streams in the ISE.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/Color",
            "enum": [
              "ErrorForegroundColor",
              "ErrorBackgroundColor",
              "WarningForegroundColor",
              "WarningBackgroundColor",
              "VerboseForegroundColor",
              "VerboseBackgroundColor",
              "DebugForegroundColor",
              "DebugBackgroundColor"
            ]
          }
        },
        "Console": {
          "$comment": "Colors that relate to 'ConsolePane' colors in the original StorableColorTheme schema.",
          "title": "Console Colors",
          "description": "Console pane and syntax highlighting colors.",
          "type": "object",
          "properties": {
            "BackgroundColor": {
              "$ref": "#/definitions/Color"
            },
            "TextBackgroundColor": {
              "$ref": "#/definitions/Color"
            },
            "ForegroundColor": {
              "$ref": "#/definitions/Color"
            },
            "PowerShell": {
              "$comment": "Colors that relate to 'ConsoleTokenColors' values in the original StorableColorTheme schema.",
              "title": "PowerShell Console Colors",
              "description": "PowerShell syntax highlighting colors in the console pane.",
              "type": "object",
              "properties": {
                "Attribute": {
                  "$ref": "#/definitions/Color"
                },
                "Command": {
                  "$ref": "#/definitions/Color"
                },
                "CommandArgument": {
                  "$ref": "#/definitions/Color"
                },
                "CommandParameter": {
                  "$ref": "#/definitions/Color"
                },
                "Comment": {
                  "$ref": "#/definitions/Color"
                },
                "GroupEnd": {
                  "$ref": "#/definitions/Color"
                },
                "GroupStart": {
                  "$ref": "#/definitions/Color"
                },
                "Keyword": {
                  "$ref": "#/definitions/Color"
                },
                "LineContinuation": {
                  "$ref": "#/definitions/Color"
                },
                "LoopLabel": {
                  "$ref": "#/definitions/Color"
                },
                "Member": {
                  "$ref": "#/definitions/Color"
                },
                "NewLine": {
                  "$ref": "#/definitions/Color"
                },
                "Number": {
                  "$ref": "#/definitions/Color"
                },
                "Operator": {
                  "$ref": "#/definitions/Color"
                },
                "Position": {
                  "$ref": "#/definitions/Color"
                },
                "StatementSeparator": {
                  "$ref": "#/definitions/Color"
                },
                "String": {
                  "$ref": "#/definitions/Color"
                },
                "Type": {
                  "$ref": "#/definitions/Color"
                },
                "Unknown": {
                  "$ref": "#/definitions/Color"
                },
                "Variable": {
                  "$ref": "#/definitions/Color"
                }
              }
            }
          }
        },
        "Editor": {
          "$comment": "Colors that relate to 'ScriptPane' colors in the original StorableColorTheme.",
          "title": "Script Editor Colors",
          "description": "Script editor pane and syntax highlighting colors.",
          "type": "object",
          "properties": {
            "BackgroundColor": {
              "$ref": "#/definitions/Color"
            },
            "ForegroundColor": {
              "$ref": "#/definitions/Color"
            },
            "PowerShell": {
              "$comment": "Colors that relate to 'TokenColors' values in the original StorableColorTheme schema.",
              "title": "PowerShell Editor Colors",
              "description": "PowerShell syntax highlighting colors in the editor pane.",
              "type": "object",
              "properties": {
                "Attribute": {
                  "$ref": "#/definitions/Color"
                },
                "Command": {
                  "$ref": "#/definitions/Color"
                },
                "CommandArgument": {
                  "$ref": "#/definitions/Color"
                },
                "CommandParameter": {
                  "$ref": "#/definitions/Color"
                },
                "Comment": {
                  "$ref": "#/definitions/Color"
                },
                "GroupEnd": {
                  "$ref": "#/definitions/Color"
                },
                "GroupStart": {
                  "$ref": "#/definitions/Color"
                },
                "Keyword": {
                  "$ref": "#/definitions/Color"
                },
                "LineContinuation": {
                  "$ref": "#/definitions/Color"
                },
                "LoopLabel": {
                  "$ref": "#/definitions/Color"
                },
                "Member": {
                  "$ref": "#/definitions/Color"
                },
                "NewLine": {
                  "$ref": "#/definitions/Color"
                },
                "Number": {
                  "$ref": "#/definitions/Color"
                },
                "Operator": {
                  "$ref": "#/definitions/Color"
                },
                "Position": {
                  "$ref": "#/definitions/Color"
                },
                "StatementSeparator": {
                  "$ref": "#/definitions/Color"
                },
                "String": {
                  "$ref": "#/definitions/Color"
                },
                "Type": {
                  "$ref": "#/definitions/Color"
                },
                "Unknown": {
                  "$ref": "#/definitions/Color"
                },
                "Variable": {
                  "$ref": "#/definitions/Color"
                }
              }
            },
            "XML": {
              "$comment": "Colors that relate to 'XMLTokenColors' values in the original StorableColorTheme schema.",
              "title": "XML Console Colors",
              "description": "XML syntax highlighting colors in the editor pane.",
              "type": "object",
              "propertyNames": {
                "enum": [
                  "CharacterData",
                  "QuotedString",
                  "Comment",
                  "CommentDelimiter",
                  "15",
                  "13",
                  "12",
                  "14",
                  "18",
                  "MarkupExtension",
                  "Quote",
                  "17",
                  "ElementName",
                  "11",
                  "19",
                  "16",
                  "Attribute",
                  "10",
                  "Tag",
                  "Text"
                ],
                "$ref": "#/definitions/Color"
                // "pattern": "^(CharacterData|QuotedString|Comment|CommentDelimiter|15|13|12|14|18|MarkupExtension|Quote|17|ElementName|11|19|16|Attribute|10|Tag|Text)$",
              }
              /* "properties": {
                "CharacterData": {
                  "$ref": "#/definitions/Color"
                },
                "QuotedString": {
                  "$ref": "#/definitions/Color"
                },
                "Comment": {
                  "$ref": "#/definitions/Color"
                },
                "CommentDelimiter": {
                  "$ref": "#/definitions/Color"
                },
