            }
          }
        }
      }
    }
  },
  "definitions": {
    "Color": {
      // each color property should have either a number value or a hexadecimal string.
      "title": "Color",
      "$comment": "A color value, either in decimal ARGB format or hexadecimal ARGB format.",
      "oneOf": [
        { "$ref": "#/definitions/ARGB" },
        { "$ref": "#/definitions/Hex" }
      ]
    },
    "ScARGB": {
      "title": "ScARGB Color",
      "description": "Alpha, Red, Green, and Blue color values in ScARGB format, 0.0-1.0.",
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      },
      "minItems": 3,
      "maxItems": 4,
      "default": [1.0, 0.0, 0.141, 0.337]
    },
    "ARGB": {
      "title": "Decimal ARGB Color",
      "description": "Alpha, Red, Green, and Blue combined color values in an integer. The default value is equal to 0xFFFF0000, or Red.",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "default": -65536
    },
    "Hex": {
      "title": "Hexadecimal ARGB Color",
      "description": "Alpha, Red, Green, and Blue color values in hexadecimal format, 00-FF.",
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}$",
      "default": "FF012345"
    }
  }
}